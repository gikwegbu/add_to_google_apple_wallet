# macOS
.DS_Store
**/.DS_Store

# Certificates and Keys
*.pem
*.p12
*.p8
*.key
apple/certs/
core/apple/certs/

# Service account & credentials
*service-account*.json
reisty-*.json
core/service-account.json

# Pass templates build artifacts & local configurations
core/apple/templates/*.pkpass
core/apple/templates/*.json
!core/apple/templates/*.json.example
*.pkpass

# Environment variables
# Ignore all .env files and their variants across all directories
.env
.env.*
.env_*
*.env
**/.env
**/.env.*
**/.env_*

# Allow example environment templates into version control
!**/.env.example
!**/*.env.example
